<div id="freshrss-githubdiff-configure">
	<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
		<input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />
		<div class="form-group">
			<label class="group-name" for="github_diff_pat">GitHub personal access token</label>
			<div class="group-controls">
				<input type="password" class="w50" name="github_diff_pat" id="github_diff_pat" autocomplete="off"
					placeholder="<?= $this->pat !== '' ? 'Token set - leave blank to keep' : 'ghp_...' ?>" />
				<p class="help">Used to fetch commit diffs from the GitHub API. A token with public read access is enough.</p>
			</div>
		</div>
		<div class="form-group form-actions">
			<div class="group-controls">
				<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
			</div>
		</div>
	</form>
</div>
