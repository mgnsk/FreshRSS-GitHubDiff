{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/repos/[^/]+/[^/]+/commits/[0-9a-f]{7,40}"
  },
  "response": {
    "status": 200,
    "bodyFileName": "commit_{{request.pathSegments.[4]}}.json",
    "transformers": [
      "response-template"
    ],
    "headers": {
      "Content-Type": "application/json"
    }
  }
}